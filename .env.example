SGI_APP_ENV=development
SGI_APP_DEBUG=0
SGI_APP_URL=http://localhost/SGI/
# Prefixo da URL quando publicado em subdiretório; vazio para domínio na raiz.
SGI_BASE_PATH=

SGI_DB_HOST=localhost
SGI_DB_PORT=3306
SGI_DB_NAME=sgi
SGI_DB_USER=root
SGI_DB_PASSWORD=

SGI_UPLOAD_DIR=storage/uploads/turmas
SGI_REGULAMENTOS_DIR=storage/uploads/regulamentos
SGI_FOTOS_DIR=storage/uploads/fotos
SGI_IMPORT_DIR=storage/imports
SGI_SESSION_DIR=storage/sessions

# Os testes com banco são executados somente pelos wrappers Docker, que criam
# um container e uma base descartáveis. Não configure um SQL de testes aqui.
