{
    "name": "sesi/sgi",
    "description": "Sistema de Gestão de Interclasses",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "smalot/pdfparser": "^2.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.75"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test:unit": "phpunit --configuration phpunit.xml --testsuite unit",
        "lint": "@php tools/lint.php",
        "cs:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "analyse": "phpstan analyse --configuration=phpstan.neon"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.12"
        },
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
